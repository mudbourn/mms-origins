{
  "type": "origins:multiple",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/arrow_up.png",
      "text": {
        "translate": "badge.mms_origins.wetness.0"
      }
    },
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/info.png",
      "text": {
        "translate": "badge.mms_origins.wetness.1"
      }
    }
  ],
  "resource": {
    "type": "origins:resource",
    "min": 0,
    "max": 300,
    "start_value": 0,
    "hud_render": {
      "bar_index": 2,
      "condition": {
        "type": "origins:resource",
        "resource": "*:*_resource",
        "comparison": ">",
        "compare_to": 0
      }
    }
  },
  "soak": {
    "type": "origins:action_over_time",
    "interval": 5,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_resource",
      "operation": "set",
      "change": 300
    },
    "condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:fluid_height",
          "fluid": "minecraft:water",
          "comparison": ">",
          "compare_to": 0.0
        },
        {
          "type": "origins:in_rain"
        }
      ]
    }
  },
  "dry": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_resource",
      "operation": "add",
      "change": -10
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:fluid_height",
          "fluid": "minecraft:water",
          "comparison": "==",
          "compare_to": 0.0
        },
        {
          "type": "origins:in_rain",
          "inverted": true
        }
      ]
    }
  },
  "drink": {
    "type": "origins:action_on_item_use",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_resource",
      "operation": "add",
      "change": 150
    },
    "item_condition": {
      "type": "origins:ingredient",
      "ingredient": {
        "item": "minecraft:potion"
      }
    }
  },
  "drink_tooltip": {
    "type": "origins:tooltip",
    "text": {
      "text": "+150 Wetness",
      "color": "aqua"
    },
    "item_condition": {
      "type": "origins:ingredient",
      "ingredient": {
        "item": "minecraft:potion"
      }
    }
  },
  "respawn": {
    "type": "origins:action_on_callback",
    "entity_action_respawned": {
      "type": "origins:change_resource",
      "resource": "*:*_resource",
      "operation": "set",
      "change": 0
    }
  }
}
