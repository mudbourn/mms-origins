{
  "type": "origins:multiple",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/arrow_up.png",
      "text": {
        "translate": "badge.mms_origins.wetness.0"
      }
    },
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/info.png",
      "text": {
        "translate": "badge.mms_origins.wetness.1"
      }
    },
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/star.png",
      "text": {
        "translate": "badge.mms_origins.wetness.2"
      }
    },
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/info.png",
      "text": {
        "translate": "badge.mms_origins.wetness.3"
      }
    }
  ],
  "resource": {
    "type": "origins:resource",
    "min": 0,
    "max": 300,
    "start_value": 0,
    "hud_render": {
      "bar_index": 2,
      "condition": {
        "type": "origins:resource",
        "resource": "mms_origins:wetness_resource",
        "comparison": ">",
        "compare_to": 0
      }
    }
  },
  "soak": {
    "type": "origins:action_over_time",
    "interval": 5,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:wetness_resource",
      "operation": "set",
      "change": 300
    },
    "condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:fluid_height",
          "fluid": "minecraft:water",
          "comparison": ">",
          "compare_to": 0.0
        },
        {
          "type": "origins:in_rain"
        }
      ]
    }
  },
  "dry": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:wetness_resource",
      "operation": "add",
      "change": -10
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:fluid_height",
          "fluid": "minecraft:water",
          "comparison": "==",
          "compare_to": 0.0
        },
        {
          "type": "origins:in_rain",
          "inverted": true
        }
      ]
    }
  },
  "drink": {
    "type": "origins:action_on_item_use",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:wetness_resource",
      "operation": "add",
      "change": 150
    },
    "item_condition": {
      "type": "origins:ingredient",
      "ingredient": {
        "item": "minecraft:potion"
      }
    }
  },
  "drink_tooltip": {
    "type": "origins:tooltip",
    "text": {
      "text": "+150 Wetness",
      "color": "aqua"
    },
    "item_condition": {
      "type": "origins:ingredient",
      "ingredient": {
        "item": "minecraft:potion"
      }
    }
  },
  "respawn": {
    "type": "origins:action_on_callback",
    "entity_action_respawned": {
      "type": "origins:change_resource",
      "resource": "mms_origins:wetness_resource",
      "operation": "set",
      "change": 0
    }
  },
  "moisture": {
    "type": "origins:resource",
    "min": 0,
    "max": 600,
    "start_value": 600,
    "hud_render": {
      "bar_index": 1,
      "condition": {
        "type": "origins:resource",
        "resource": "mms_origins:wetness_moisture",
        "comparison": "<",
        "compare_to": 599
      }
    }
  },
  "moisture_water_rain_or_cauldron": {
    "type": "origins:action_over_time",
    "interval": 5,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:wetness_moisture",
      "operation": "add",
      "change": 15
    },
    "condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:fluid_height",
          "fluid": "minecraft:water",
          "comparison": "!=",
          "compare_to": 0
        },
        {
          "type": "origins:in_block",
          "block_condition": {
            "type": "origins:block",
            "block": "minecraft:water_cauldron"
          }
        },
        {
          "type": "origins:in_rain"
        }
      ]
    }
  },
  "moisture_water_bottle": {
    "type": "origins:action_on_item_use",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:wetness_moisture",
      "change": 60,
      "operation": "add"
    },
    "item_condition": {
      "type": "origins:ingredient",
      "ingredient": {
        "item": "minecraft:potion"
      }
    }
  },
  "moisture_water_bottle_tooltip": {
    "type": "origins:tooltip",
    "text": {
      "text": "+60 Moisture",
      "color": "aqua"
    },
    "item_condition": {
      "type": "origins:ingredient",
      "ingredient": {
        "item": "minecraft:potion"
      }
    }
  },
  "moisture_respawn": {
    "type": "origins:action_on_callback",
    "entity_action_respawned": {
      "type": "origins:change_resource",
      "resource": "mms_origins:wetness_moisture",
      "change": 600,
      "operation": "set"
    }
  },
  "moisture_tick": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:wetness_moisture",
      "operation": "add",
      "change": -1
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:and",
          "conditions": [
            {
              "type": "origins:fluid_height",
              "fluid": "minecraft:water",
              "comparison": "==",
              "compare_to": 0
            },
            {
              "type": "origins:in_block",
              "block_condition": {
                "type": "origins:block",
                "block": "minecraft:water_cauldron"
              },
              "inverted": true
            }
          ]
        },
        {
          "type": "origins:dimension",
          "dimension": "minecraft:the_nether",
          "inverted": true
        }
      ]
    }
  },
  "moisture_tick_nether": {
    "type": "origins:action_over_time",
    "interval": 10,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:wetness_moisture",
      "operation": "add",
      "change": -1
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:and",
          "conditions": [
            {
              "type": "origins:submerged_in",
              "fluid": "minecraft:water",
              "inverted": true
            },
            {
              "type": "origins:in_block",
              "block_condition": {
                "type": "origins:block",
                "block": "minecraft:water_cauldron"
              },
              "inverted": true
            }
          ]
        },
        {
          "type": "origins:dimension",
          "dimension": "minecraft:the_nether"
        }
      ]
    }
  },
  "moisture_oxigen": {
    "type": "origins:action_over_time",
    "interval": 5,
    "entity_action": {
      "type": "origins:gain_air",
      "value": 200
    },
    "condition": {
      "type": "origins:resource",
      "resource": "mms_origins:wetness_moisture",
      "comparison": "!=",
      "compare_to": 0
    }
  },
  "moisture_extend_conduit": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:apply_effect",
      "effect": {
        "duration": 6000,
        "effect": "minecraft:conduit_power"
      }
    },
    "interval": 20,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:status_effect",
          "effect": "minecraft:conduit_power"
        },
        {
          "type": "origins:submerged_in",
          "fluid": "minecraft:water"
        },
        {
          "type": "origins:block_in_radius",
          "radius": 32,
          "block_condition": {
            "type": "origins:block",
            "block": "minecraft:conduit"
          },
          "comparison": ">=",
          "compare_to": 1
        }
      ]
    }
  },
  "moisture_conduit_on_land": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:wetness_moisture",
      "change": 600,
      "operation": "set"
    },
    "interval": 10,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:status_effect",
          "effect": "minecraft:conduit_power"
        },
        {
          "type": "origins:submerged_in",
          "fluid": "minecraft:water",
          "inverted": true
        }
      ]
    }
  }
}
