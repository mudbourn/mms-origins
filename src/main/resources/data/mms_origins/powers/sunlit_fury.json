{
  "type": "origins:multiple",
  "toggle": {
    "type": "origins:toggle",
    "key": {
      "key": "key.origins.primary_active",
      "continuous": false
    }
  },
  "strength": {
    "type": "origins:modify_damage_dealt",
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        },
        {
          "type": "origins:resource",
          "resource": "mms_origins:sun_power",
          "comparison": ">",
          "compare_to": 0
        }
      ]
    },
    "modifier": {
      "name": "Sunlit fury",
      "value": 0.5,
      "operation": "multiply_base"
    }
  },
  "flare": {
    "type": "origins:action_on_callback",
    "condition": {
      "type": "origins:power_active",
      "power": "*:*_toggle"
    },
    "entity_action_gained": {
      "type": "origins:play_sound",
      "category": "players",
      "sound": "minecraft:item.bone_meal.use"
    }
  },
  "drain_solo": {
    "type": "origins:action_over_time",
    "interval": 8,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:sun_power",
      "operation": "add",
      "change": -1
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        },
        {
          "type": "origins:resource",
          "resource": "mms_origins:sun_power",
          "comparison": ">",
          "compare_to": 0
        },
        {
          "type": "mms_origins:henchmen_count",
          "comparison": "==",
          "compare_to": 0
        }
      ]
    }
  },
  "drain_pair": {
    "type": "origins:action_over_time",
    "interval": 8,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:sun_power",
      "operation": "add",
      "change": -2
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        },
        {
          "type": "origins:resource",
          "resource": "mms_origins:sun_power",
          "comparison": ">",
          "compare_to": 0
        },
        {
          "type": "mms_origins:henchmen_count",
          "comparison": "==",
          "compare_to": 1
        }
      ]
    }
  },
  "drain_host": {
    "type": "origins:action_over_time",
    "interval": 8,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:sun_power",
      "operation": "add",
      "change": -3
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        },
        {
          "type": "origins:resource",
          "resource": "mms_origins:sun_power",
          "comparison": ">",
          "compare_to": 0
        },
        {
          "type": "mms_origins:henchmen_count",
          "comparison": ">=",
          "compare_to": 2
        }
      ]
    }
  },
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/active.png",
      "text": {
        "translate": "badge.mms_origins.sunlit_fury.0"
      }
    },
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/info.png",
      "text": {
        "translate": "badge.mms_origins.sunlit_fury.1"
      }
    }
  ]
}
