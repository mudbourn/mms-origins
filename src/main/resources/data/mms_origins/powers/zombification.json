{
  "type": "origins:multiple",
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/info.png",
      "text": {
        "translate": "badge.mms_origins.zombification.0"
      }
    },
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/info.png",
      "text": {
        "translate": "badge.mms_origins.zombification.1"
      }
    },
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/star.png",
      "text": {
        "translate": "badge.mms_origins.zombification.2"
      }
    }
  ],
  "creep": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:zombie_meter",
      "change": 1,
      "operation": "add"
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:dimension",
          "dimension": "minecraft:overworld"
        },
        {
          "type": "origins:resource",
          "resource": "mms_origins:zombie_meter",
          "comparison": "<",
          "compare_to": 600
        }
      ]
    }
  },
  "recover": {
    "type": "origins:action_over_time",
    "interval": 40,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:zombie_meter",
      "change": -1,
      "operation": "add"
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:dimension",
          "dimension": "minecraft:the_nether"
        },
        {
          "type": "origins:resource",
          "resource": "mms_origins:zombie_meter",
          "comparison": ">",
          "compare_to": 0
        },
        {
          "type": "origins:resource",
          "resource": "mms_origins:zombie_meter",
          "comparison": "<",
          "compare_to": 600
        }
      ]
    }
  },
  "flesh_craving": {
    "name": "Zombification",
    "type": "origins:prevent_item_use",
    "item_condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:food"
        },
        {
          "type": "origins:ingredient",
          "ingredient": {
            "tag": "mms_origins:zombie_diet"
          },
          "inverted": true
        },
        {
          "type": "origins:ingredient",
          "ingredient": {
            "tag": "originstweaks:golden_food"
          },
          "inverted": true
        }
      ]
    },
    "condition": {
      "type": "origins:resource",
      "resource": "mms_origins:zombie_meter",
      "comparison": ">=",
      "compare_to": 600
    }
  },
  "zombify_toll": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:play_sound",
          "sound": "minecraft:entity.piglin.death"
        },
        {
          "type": "origins:change_resource",
          "resource": "mms_origins:zombify_sounded",
          "change": 1,
          "operation": "set"
        }
      ]
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:resource",
          "resource": "mms_origins:zombie_meter",
          "comparison": ">=",
          "compare_to": 600
        },
        {
          "type": "origins:resource",
          "resource": "mms_origins:zombify_sounded",
          "comparison": "==",
          "compare_to": 0
        }
      ]
    }
  },
  "zombify_toll_reset": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:zombify_sounded",
      "change": 0,
      "operation": "set"
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:resource",
          "resource": "mms_origins:zombie_meter",
          "comparison": "<",
          "compare_to": 600
        },
        {
          "type": "origins:resource",
          "resource": "mms_origins:zombify_sounded",
          "comparison": "==",
          "compare_to": 1
        }
      ]
    }
  },
  "cure": {
    "type": "origins:action_on_item_use",
    "trigger_type": "finish",
    "item_condition": {
      "type": "origins:ingredient",
      "ingredient": {
        "tag": "originstweaks:golden_food"
      }
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:play_sound",
          "sound": "minecraft:entity.zombie_villager.cure",
          "pitch": 0.65
        },
        {
          "type": "origins:delay",
          "ticks": 120,
          "action": {
            "type": "origins:change_resource",
            "resource": "mms_origins:zombie_meter",
            "change": 0,
            "operation": "set"
          }
        }
      ]
    },
    "condition": {
      "type": "origins:resource",
      "resource": "mms_origins:zombie_meter",
      "comparison": ">=",
      "compare_to": 600
    }
  }
}
