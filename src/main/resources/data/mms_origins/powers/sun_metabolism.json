{
  "type": "origins:multiple",
  "hidden": true,
  "bask": {
    "type": "origins:action_over_time",
    "interval": 12,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:sun_power",
      "operation": "add",
      "change": 1
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:exposed_to_sun"
        },
        {
          "type": "origins:resource",
          "resource": "mms_origins:sunlit_fury_active",
          "comparison": "==",
          "compare_to": 0
        },
        {
          "type": "mms_origins:sun_strain",
          "resource": "mms_origins:nature_reclaim_strain"
        }
      ]
    }
  },
  "drink": {
    "type": "origins:action_on_item_use",
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:resource",
          "resource": "mms_origins:sun_power",
          "comparison": "<",
          "compare_to": 35
        },
        {
          "type": "origins:resource",
          "resource": "mms_origins:sunlit_fury_active",
          "comparison": "==",
          "compare_to": 0
        }
      ]
    },
    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:resource",
        "resource": "mms_origins:sun_power",
        "comparison": "<",
        "compare_to": 25
      },
      "if_action": {
        "type": "origins:change_resource",
        "resource": "mms_origins:sun_power",
        "operation": "add",
        "change": 10
      },
      "else_action": {
        "type": "origins:change_resource",
        "resource": "mms_origins:sun_power",
        "operation": "set",
        "change": 35
      }
    },
    "item_condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:ingredient",
          "ingredient": {
            "item": "minecraft:potion"
          }
        },
        {
          "type": "origins:ingredient",
          "ingredient": {
            "item": "scorchful:water_skin"
          }
        }
      ]
    }
  },
  "sun_intake": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:sun_power",
      "operation": "add",
      "change": 1
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:exposed_to_sun"
        },
        {
          "type": "mms_origins:sun_intake",
          "peak": 0.4,
          "sharpness": 3.0
        },
        {
          "type": "mms_origins:sun_strain",
          "resource": "mms_origins:nature_reclaim_strain"
        }
      ]
    }
  },
  "grove_sun_intake": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "mms_origins:sun_power",
      "operation": "add",
      "change": 1
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:exposed_to_sun"
        },
        {
          "type": "mms_origins:sun_intake",
          "peak": 0.2,
          "sharpness": 3.0
        },
        {
          "type": "mms_origins:sun_strain",
          "resource": "mms_origins:nature_reclaim_strain"
        },
        {
          "type": "origins:biome",
          "condition": {
            "type": "origins:in_tag",
            "tag": "mms_origins:enchanted_groves"
          }
        }
      ]
    }
  }
}
