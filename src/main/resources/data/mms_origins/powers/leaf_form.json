  "toggle": {
    "type": "origins:toggle",
    "active_by_default": false,
    "key": {
      "key": "key.mms_origins.unbound"
    }
  },
  "shift": {
    "type": "origins:active_self",
    "cooldown": 20,
    "hud_render": {
      "should_render": false
    },
    "key": {
      "key": "key.origins.secondary_active",
      "continuous": false
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:sneaking"
        },
        {
          "type": "origins:or",
          "conditions": [
            {
              "type": "origins:power_active",
              "power": "mms_origins:leaf_form_toggle",
              "inverted": true
            },
            {
              "type": "mms_origins:surface",
              "max": 1.0
            }
          ]
        }
      ]
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:if_else",
          "condition": {
            "type": "origins:power_active",
            "power": "mms_origins:leaf_form_toggle"
          },
          "if_action": {
            "type": "origins:and",
            "actions": [
              {
                "type": "mms_origins:surface",
                "max": 1.0
              },
              {
                "type": "origins:change_resource",
                "resource": "mms_origins:leaf_form_morph",
                "operation": "set",
                "change": 0
              }
            ]
          }
        },
        {
          "type": "origins:toggle",
          "power": "mms_origins:leaf_form_toggle"
        },
        {
          "type": "origins:play_sound",
          "sound": "minecraft:block.azalea_leaves.place",
          "volume": 1.0,
          "pitch": 0.9
        }
      ]
    }
  },
  "morph": {
    "type": "origins:resource",
    "min": 0,
    "max": 20,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    }
  },
  "morph_tick": {
    "type": "origins:action_over_time",
    "interval": 1,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power_active",
          "power": "mms_origins:leaf_form_toggle"
        },
        {
          "type": "origins:resource",
          "resource": "mms_origins:leaf_form_morph",
          "comparison": "<",
          "compare_to": 20
        }
      ]
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "mms_origins:leaf_form_morph",
          "operation": "add",
          "change": 1
        },
        {
          "type": "origins:apply_effect",
          "effect": {
            "effect": "minecraft:slowness",
            "duration": 3,
            "amplifier": 3,
            "show_icon": false,
            "show_particles": false
          }
        },
        {
          "type": "origins:if_else",
          "condition": {
            "type": "origins:resource",
            "resource": "mms_origins:leaf_form_morph",
            "comparison": ">=",
            "compare_to": 20
          },
          "if_action": {
            "type": "origins:play_sound",
            "sound": "minecraft:block.azalea_leaves.place",
            "volume": 1.0,
            "pitch": 1.2
          }
        }
      ]
    }
  },
  "morph_fx": {
