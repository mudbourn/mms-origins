{
	"type": "origins:multiple",
	"hidden": true,
	"hurt_death": {
		"type": "origins:self_action_when_hit",
		"entity_action": {
			"type": "origins:if_else",
			"condition": {
				"type": "origins:health",
				"comparison": ">",
				"compare_to": 0
			},
			"if_action": {
				"type": "origins:play_sound",
				"sound": "minecraft:entity.cat.hurt"
			},
			"else_action": {
				"type": "origins:play_sound",
				"sound": "minecraft:entity.cat.death"
			}
		},
		"cooldown": 1
	},
	"sleep_init": {
		"type": "origins:action_on_callback",
		"entity_action_added": {
			"type": "origins:execute_command",
			"command": "scoreboard objectives add feline_sleep minecraft.custom:minecraft.time_since_rest"
		}
	},
	"sleep": {
		"type": "origins:action_over_time",
		"interval": 200,
		"entity_action": {
			"type": "origins:play_sound",
			"sound": "minecraft:entity.cat.purr",
			"category": "players",
			"volume": 0.25
		},
		"condition": {
			"type": "origins:scoreboard",
			"objective": "feline_sleep",
			"compare_to": 0,
			"comparison": "=="
		}
	}
}
