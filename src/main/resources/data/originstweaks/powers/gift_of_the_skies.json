						"type": "origins:and",
						"actions": [
							{
								"type": "origins:toggle",
								"power": "originstweaks:slow_falling_toggle"
							},
							{
								"type": "origins:if_else",
								"condition": {
									"type": "origins:power_active",
									"power": "originstweaks:slow_falling_toggle"
								},
								"if_action": {
									"type": "origins:execute_command",
									"command": "title @s actionbar \"Slow falling on\""
								},
								"else_action": {
									"type": "origins:execute_command",
									"command": "title @s actionbar \"Slow falling off\""
								}
							}
						]
					}
				},
				{
					"type": "origins:change_resource",
					"resource": "*:*_hold_ticks",
					"change": 0,
					"operation": "set"
				}
			]
		}
	}
}
