		}
	},
	"hold": {
		"type": "origins:active_self",
		"cooldown": 1,
		"hud_render": {
			"should_render": false
		},
		"key": {
			"key": "key.origins.secondary_active",
			"continuous": true
		},
		"entity_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:trigger_cooldown",
					"power": "*:*_held_recent"
				},
				{
					"type": "origins:change_resource",
					"resource": "*:*_hold_ticks",
					"change": 1,
					"operation": "add"
				},
				{
					"type": "origins:if_else",
					"condition": {
						"type": "origins:resource",
						"resource": "*:*_hold_ticks",
						"comparison": "==",
						"compare_to": 10
					},
					"if_action": {
						"type": "origins:and",
						"actions": [
							{
								"type": "origins:toggle",
								"power": "originstweaks:gift_of_the_skies_flight_toggle"
							},
							{
								"type": "origins:play_sound",
								"sound": "minecraft:entity.phantom.flap",
								"volume": 0.6,
								"pitch": 1.4
							},
							{
								"type": "origins:if_else",
								"condition": {
									"type": "origins:power_active",
									"power": "originstweaks:gift_of_the_skies_flight_toggle"
								},
								"if_action": {
									"type": "origins:execute_command",
									"command": "title @s actionbar \"Wings spread\""
								},
								"else_action": {
									"type": "origins:execute_command",
									"command": "title @s actionbar \"Wings folded\""
								}
							}
						]
					}
				}
			]
		}
	},
