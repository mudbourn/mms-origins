{
	"type": "origins:multiple",
	"badges": [
		{
			"type": "origins:tooltip",
			"sprite": "origins:textures/gui/badge/toggle.png",
			"text": {
				"translate": "badge.originstweaks.phantomize.0"
			}
		},
		{
			"type": "origins:tooltip",
			"sprite": "origins:textures/gui/badge/arrow_up.png",
			"text": {
				"translate": "badge.originstweaks.phantomize.1"
			}
		},
		{
			"type": "origins:tooltip",
			"sprite": "origins:textures/gui/badge/info.png",
			"text": {
				"translate": "badge.originstweaks.phantomize.2"
			}
		},
		{
			"type": "origins:tooltip",
			"sprite": "origins:textures/gui/badge/active.png",
			"text": {
				"translate": "badge.originstweaks.phantomize.3"
			}
		}
	],
	"toggle": {
		"type": "origins:toggle",
		"key": {
			"key": "key.origins.primary_active"
		},
		"retain_state": false,
		"condition": {
			"type": "origins:resource",
			"resource": "*:soulbound_energy",
			"comparison": "!=",
			"compare_to": 0
		}
	},
	"drain_soul_power": {
		"type": "origins:action_over_time",
		"entity_action": {
			"type": "origins:change_resource",
			"resource": "*:soulbound_energy",
			"change": -1,
			"operation": "add"
		},
		"interval": 40,
		"condition": {
			"type": "origins:power_active",
			"power": "*:*_toggle"
		}
	},
	"flight": {
		"type": "origins:elytra_flight",
		"render_elytra": false,
		"condition": {
			"type": "origins:and",
			"conditions": [
				{
					"type": "origins:power_active",
					"power": "*:phantomize_toggle"
				},
				{
					"type": "origins:resource",
					"resource": "*:soulbound_energy",
					"comparison": ">",
					"compare_to": 0
				}
			]
		}
	},
	"flight_toll": {
		"type": "origins:action_over_time",
		"entity_action": {
			"type": "origins:change_resource",
			"resource": "*:soulbound_energy",
			"change": -1,
			"operation": "add"
		},
		"interval": 20,
		"condition": {
			"type": "origins:and",
			"conditions": [
				{
					"type": "origins:power_active",
					"power": "*:phantomize_toggle"
				},
				{
					"type": "origins:fall_flying"
				}
			]
		}
	}
}
