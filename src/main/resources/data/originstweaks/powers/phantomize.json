			"should_render": false
		},
		"key": {
			"key": "key.origins.secondary_active"
		},
		"press_condition": {
			"type": "origins:sneaking"
		},
		"press_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:toggle",
					"power": "originstweaks:phantomize_toggle"
				},
				{
					"type": "origins:play_sound",
					"sound": "minecraft:entity.phantom.ambient",
