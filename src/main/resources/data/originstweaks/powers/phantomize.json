					"volume": 1.0,
					"pitch": 0.9
				}
			]
		}
	},
	"morph": {
		"type": "origins:resource",
		"min": 0,
		"max": 10,
		"start_value": 0,
		"hud_render": {
			"should_render": false
		}
	},
	"morph_tick": {
		"type": "origins:action_over_time",
		"interval": 1,
		"condition": {
			"type": "origins:and",
			"conditions": [
				{
					"type": "origins:power_active",
					"power": "*:phantomize_toggle"
				},
				{
					"type": "origins:resource",
					"resource": "*:phantomize_morph",
					"comparison": "<",
					"compare_to": 10
				}
			]
		},
		"entity_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:change_resource",
					"resource": "*:phantomize_morph",
					"operation": "add",
					"change": 1
				},
				{
					"type": "origins:apply_effect",
					"effect": {
						"effect": "minecraft:slowness",
						"duration": 3,
						"amplifier": 3,
						"show_icon": false,
						"show_particles": false
					}
				},
				{
					"type": "origins:if_else",
					"condition": {
						"type": "origins:resource",
						"resource": "*:phantomize_morph",
						"comparison": ">=",
						"compare_to": 10
					},
					"if_action": {
						"type": "origins:play_sound",
						"sound": "minecraft:entity.phantom.ambient",
						"volume": 1.0,
						"pitch": 1.2
					}
				}
			]
		}
	},
	"morph_reset": {
		"type": "origins:action_over_time",
		"interval": 1,
		"condition": {
			"type": "origins:and",
			"conditions": [
				{
					"type": "origins:power_active",
