{
	"type": "origins:multiple",
	"hidden": true,
	"hurt_death": {
		"type": "origins:self_action_when_hit",
		"entity_action": {
			"type": "origins:if_else",
			"condition": {
				"type": "origins:health",
				"comparison": ">",
				"compare_to": 0
			},
			"if_action": {
				"type": "origins:if_else",
				"condition": {
					"type": "origins:origin",
					"layer": "originstweaks:beastfolk_tail",
					"origin": "originstweaks:beastfolk_tail_fox"
				},
				"if_action": {
					"type": "origins:if_else",
					"condition": {
						"type": "origins:origin",
						"layer": "originstweaks:beastfolk_options",
						"origin": "originstweaks:beastfolk_collar"
					},
					"if_action": {
						"type": "origins:play_sound",
						"sound": "mms_origins:beastfolk.fox_hurt"
					},
					"else_action": {
						"type": "origins:play_sound",
						"sound": "mms_origins:beastfolk.fox_collarless_hurt"
					}
				},
				"else_action": {
					"type": "origins:if_else",
					"condition": {
						"type": "origins:origin",
						"layer": "originstweaks:beastfolk_options",
						"origin": "originstweaks:beastfolk_collar"
					},
					"if_action": {
						"type": "origins:play_sound",
						"sound": "mms_origins:beastfolk.collar_hurt"
					},
					"else_action": {
						"type": "origins:play_sound",
						"sound": "mms_origins:beastfolk.hurt"
					}
				}
			}
		},
		"cooldown": 1
	},
	"sleep_init": {
		"type": "origins:action_on_callback",
		"entity_action_added": {
			"type": "origins:execute_command",
			"command": "scoreboard objectives add beastfolk_sleep minecraft.custom:minecraft.time_since_rest"
		}
	},
	"sleep": {
		"type": "origins:action_over_time",
		"interval": 200,
		"entity_action": {
			"type": "origins:play_sound",
			"sound": "minecraft:entity.cat.purr",
			"category": "players",
			"volume": 0.25
		},
		"condition": {
			"type": "origins:scoreboard",
			"objective": "beastfolk_sleep",
			"compare_to": 0,
			"comparison": "=="
		}
	}
}
