{
  "schemaVersion": 1,
  "id": "mms_origins",
  "version": "${version}",
  "name": "MMS Origins",
  "description": "MMS origin content for Origins: Legacy. Adds five original origins, ports Origin Furs' model layer, and carries the MMS tweaks to Origins Classes that previously shipped as a datapack.",
  "authors": [
    "Mudbourn"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "info.mudbourn.mmsorigins.MmsOrigins"
    ],
    "client": [
      "info.mudbourn.mmsorigins.client.MmsOriginsClient"
    ],
    "appleskin": [
      "info.mudbourn.mmsorigins.client.AppleSkinCompat"
    ]
  },
  "mixins": [
    "mms_origins.mixins.json",
    "mms_origins.client.mixins.json",
    "mms_origins.originsclasses.mixins.json",
    "mms_origins.nocreativedrift.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "origins": ">=1.12.0",
    "apoli": ">=2.12.0",
    "mms_render_common": "*",
    "scorchful": ">=0.16.8",
    "frostiful": ">=2.4.0",
    "friendsandfoes": ">=5.0.5"
  },
  "recommends": {
    "origins-legacy-classes": "*",
    "jobsplus": "*"
  },
  "suggests": {
    "mms_combat": "*",
    "appleskin": "*"
  }
}
